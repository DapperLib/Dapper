<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Dapper.ProviderTools</AssemblyName>
    <PackageTags>orm;sql;micro-orm</PackageTags>
    <Title>Dapper Provider Tools</Title>
    <Description>Provider-agnostic ADO.NET helper utilities</Description>
    <Authors>Marc Gravell</Authors>
    <TargetFrameworks>net461;netstandard2.0;net8.0</TargetFrameworks>
    <SignAssembly>true</SignAssembly>
    <!-- not shipped: last release was 2.0.90 (April 2021) and it has had no work since.
         Packing it would push a 2.1.x of a dormant package on the next release, and would
         need a nuget.org trusted-publishing policy kept alive for it. Un-set this to
         resume shipping it. -->
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <PackageReference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net461' ">
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
